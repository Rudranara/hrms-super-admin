// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
}

model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(191)
  passwordHash String @map("password_hash") @db.VarChar(255)
  role Role @default(OWNER)
  isActive Boolean @default(true) @map("is_active")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecretEncrypted String? @map("two_factor_secret_encrypted") @db.Text
  twoFactorPendingSecretEncrypted String? @map("two_factor_pending_secret_encrypted") @db.Text
  twoFactorPendingExpiresAt DateTime? @map("two_factor_pending_expires_at")
  twoFactorEnabledAt DateTime? @map("two_factor_enabled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  twoFactorChallenges TwoFactorChallenge[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  @@map("users")
}

model PasswordResetToken {
  id String @id @default(cuid())
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

enum TwoFactorChallengeType {
  ENROLLMENT
  LOGIN
}

model TwoFactorChallenge {
  id String @id @default(cuid())
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  type TwoFactorChallengeType
  rememberMe Boolean @default(false) @map("remember_me")
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("two_factor_challenges")
}

model TwoFactorRecoveryCode {
  id String @id @default(cuid())
  codeHash String @map("code_hash") @db.VarChar(255)
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, consumedAt])
  @@map("two_factor_recovery_codes")
}

model Session {
  id String @id @default(cuid())
  refreshTokenHash String @map("refresh_token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String? @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
